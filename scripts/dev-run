#!/usr/bin/env bash
# Development loop: close FTL, reinstall the mod with dev tools, relaunch, and let the
# dev autostart press Continue (or New Game). Waits until a Run is live.
# Usage: scripts/dev-run [continue|new [seed]|fresh [seed]]
#   "new" moves any saved Run to hs_continue.sav.dev-bak and answers the intro event;
#   "fresh" is a new Run that leaves the intro event open for the caller to answer.
set -euo pipefail
MODE="${1:-continue}"
SEED="${2:-}"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SAVE="$HOME/Library/Application Support/FasterThanLight"
pkill -f "$ROOT/game/FTL.app" && sleep 2 || true
pkill -9 -f "$ROOT/game/FTL.app" && sleep 1 || true # a frozen FTL ignores the polite kill
pkill -f "Hyperspace Freeze Detected" || true       # and its watchdog's dialog would linger
# Closing FTL this way looks like a crash to Hyperspace, whose popup would block the autostart.
rm -f "$SAVE/hs_crash.flag"
"$ROOT/scripts/install-mod" --dev >/dev/null
mkdir -p "$SAVE/ftlbench/live"
echo "$MODE" > "$SAVE/ftlbench/autostart"
if [[ "$MODE" != "continue" && -n "$SEED" ]]; then
    echo "$SEED" > "$SAVE/ftlbench/run_seed" # the bridge hands it to the game's New Game
elif [[ "$MODE" != "continue" ]]; then
    rm -f "$SAVE/ftlbench/run_seed"
fi
rm -f "$SAVE/ftlbench/live/state.json"
# New Game over a saved Run opens a "this deletes your run" confirmation the autostart can't answer,
# so set the saved Run aside. hs_continue.sav is Hyperspace's save (only this modded copy uses it);
# move rather than delete anyway.
if [[ "$MODE" != "continue" && -f "$SAVE/hs_continue.sav" ]]; then
    mv "$SAVE/hs_continue.sav" "$SAVE/hs_continue.sav.dev-bak"
fi
open "$ROOT/game/FTL.app"
for _ in $(seq 1 120); do
    if "$ROOT/bin/ftl" state 2>/dev/null | grep -q '"in_run":true'; then
        rm -f "$SAVE/ftlbench/autostart" # so a later manual launch doesn't auto-click
        echo "Run is live"
        exit 0
    fi
    sleep 1
done
echo "timed out waiting for a Run (see $SAVE/FTL_HS.log)" >&2
exit 1
