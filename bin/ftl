#!/usr/bin/env python3
"""ftl: the Agent's command line for a running FTL game.

Reading commands print an Observation view. Everything else is a Command, passed
as text to the mod (the only Command parser), which answers within a frame.
Exit codes: 0 ok, 1 Command rejected, 2 game not running or not responding.
"""

import os
import sys
import time
from pathlib import Path
from typing import NoReturn

BASE = Path(
    os.environ.get(
        "FTL_BENCH_DIR",
        Path.home() / "Library/Application Support/FasterThanLight/ftlbench",
    )
)
LIVE = BASE / "live"
PROMPTS = Path(__file__).resolve().parents[1] / "prompts"
VIEWS = ("state", "map", "jumps")  # Observation views the mod writes as live/<view>.json
STALE_AFTER = 3.0  # seconds without a state update before the game counts as not running
ANSWER_TIMEOUT = 3.0  # seconds to wait for the mod to answer a Command
USAGE = "usage: ftl rules|state|map|jumps | ftl events [history N] | ftl <command> [args...]"


def fail(message: str, code: int) -> NoReturn:
    print(message, file=sys.stderr)
    sys.exit(code)


def require_game() -> None:
    state = LIVE / "state.json"
    if not state.exists():
        fail("game not running (no bridge files; is FTL open with the mod installed?)", 2)
    age = time.time() - state.stat().st_mtime
    if age > STALE_AFTER:
        error = LIVE / "bridge_error.txt"
        if error.exists():
            fail(f"game not responding (mod error: {error.read_text().strip()})", 2)
        fail(f"game not running (no update from the mod for {age:.0f}s)", 2)


def send(text: str) -> tuple[str, str]:
    """Send Command text to the mod and return (status, detail).

    detail is the reason for an error, or seconds to wait for an ok `wait`.
    """
    cmd_id = f"{os.getpid()}-{time.time_ns()}"
    with (LIVE / "inbox.txt").open("a") as f:
        f.write(f"{cmd_id}\t{time.time_ns() // 1_000_000}\t{text}\n")
    results = LIVE / "results.txt"
    deadline = time.monotonic() + ANSWER_TIMEOUT
    prefix = cmd_id + "\t"
    while time.monotonic() < deadline:
        if results.exists():
            for line in results.read_text().splitlines():
                if line.startswith(prefix):
                    status, _, detail = line[len(prefix) :].partition("\t")
                    return status, detail
        time.sleep(0.01)
    fail(f"game not responding (the mod did not answer within {ANSWER_TIMEOUT:.0f}s)", 2)


def events(args: list[str]) -> None:
    """Print events as JSON lines: everything new since the last call, or `history N`."""
    run_file = LIVE / "run.txt"
    if not run_file.exists():
        fail("no Run in progress", 1)
    run = BASE / run_file.read_text().strip()
    log = run / "events.jsonl"
    text = log.read_text() if log.exists() else ""
    lines = text[: text.rfind("\n") + 1].splitlines()  # skip a line the mod is still writing
    if not args:
        cursor = run / "events.cursor"  # how many events the Agent has already read
        seen = int(cursor.read_text()) if cursor.exists() else 0
        shown = lines[seen:]
        tmp = cursor.with_suffix(".tmp")
        tmp.write_text(str(len(lines)))
        tmp.replace(cursor)  # atomic, so a crash never leaves a half-written read position
    elif len(args) == 2 and args[0] == "history" and args[1].isdigit():
        shown = lines[-int(args[1]) :] if int(args[1]) else []
    else:
        fail("usage: ftl events [history N]", 1)
    for line in shown:
        print(line)


def main(args: list[str]) -> None:
    if not args:
        fail(USAGE, 1)
    if args == ["rules"]:
        sys.stdout.write((PROMPTS / "primer.md").read_text())
        return
    require_game()
    if len(args) == 1 and args[0] in VIEWS:
        view = LIVE / f"{args[0]}.json"
        if not view.exists():
            fail("no Run in progress", 1)
        sys.stdout.write(view.read_text())
        return
    if args[0] == "events":
        events(args[1:])
        return
    status, detail = send(" ".join(args))
    if status != "ok":
        fail(detail, 1)
    if detail:
        time.sleep(float(detail))  # the mod resolved a wait


if __name__ == "__main__":
    main(sys.argv[1:])
